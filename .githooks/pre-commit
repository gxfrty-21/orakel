#!/bin/sh
set -eu

root=$(git rev-parse --show-toplevel)
cd "$root"

staged=$(git diff --cached --name-only)
if ! printf '%s\n' "$staged" | grep -Eq '\.md$|^scripts/pruefe_doku\.py$'; then
    exit 0
fi

if [ -x "$root/.venv/bin/python" ]; then
    python="$root/.venv/bin/python"
else
    python=python3
fi

printf '%s\n' "Doku-Prüfung: Markdown- oder Prüfskript-Änderung erkannt."
status=0
if printf '%s\n' "$staged" | grep -Eq '^scripts/pruefe_doku\.py$'; then
    printf '%s\n' "Doku-Prüfung: Prüfskript geändert, Negativtest wird zusätzlich ausgeführt."
    "$python" "$root/scripts/pruefe_doku.py" --negativtest || status=$?
fi
"$python" "$root/scripts/pruefe_doku.py" || status=$?
exit "$status"
