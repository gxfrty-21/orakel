# Für Railway: Diese Werte im Railway-Dashboard als Service-Variablen setzen.
# Railway liest keine .env-Datei; für den VPS-Stack bleibt diese Datei gültig.

# Domain, die auf den Server zeigt (nur Hostname, kein https://).
ORAKEL_DOMAIN=orakel.example.com

# Login für das Dashboard (HTTP Basic über HTTPS).
ORAKEL_AUTH_USER=orakel
ORAKEL_AUTH_PASS=BITTE_EIN_STARKES_PASSWORT_SETZEN

# Optional: 1 = Paper-Takt im Hintergrund starten (Simulation, keine echten Orders).
ORAKEL_TAKT=0
